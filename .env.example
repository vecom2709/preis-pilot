# Öffentliche Adresse (für kanonische URLs, hreflang und Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Open Food Facts verlangt einen eindeutigen User-Agent: App/Version (Kontakt)
PREISPILOT_USER_AGENT=Preis-Pilot/0.1 (info@vecom-design.it)
# Erst ab Phase 5/6 nötig (Konten, Haushalte, Community)
DATABASE_URL=postgres://preispilot:preispilot@localhost:5432/preispilot
# Keine Telemetrie an Vercel senden (DSGVO)
NEXT_TELEMETRY_DISABLED=1

# Preis-Pilot 2.0 – kostenlose Schlüssel, optional (ohne Schlüssel zeigt die App einen klaren Hinweis)
# Spielepreise: https://isthereanydeal.com/apps/my/
ITAD_API_KEY=
# Filme/Serien + Streaming-Verfügbarkeit (Lesezugriffs-Token v4): https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# ── Preis-Pilot 3.0: Deal-Finder ──────────────────────────────────────────
# Admin-Dashboard /de/admin (Benutzer "admin"). Mindestens 16 Zeichen.
# Ohne Wert ist das Dashboard gesperrt (503). Nur serverseitig setzen.
ADMIN_TOKEN=
# eBay Browse API (kostenloses Entwicklerkonto, developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: eBay-Partnernetzwerk-Kampagne, Links werden dann als Werbung markiert
EBAY_CAMPAIGN_ID=
# Händler-Feeds (Awin-Publisher oder Google-Merchant-CSV), JSON-Liste, z. B.:
# FEEDS_JSON=[{"key":"mein-shop","preset":"awin","country":"DE","url":"https://…"}]
FEEDS_JSON=
# Speicher: auf Netlify automatisch Blobs, lokal Datei-Speicher in .data/deals
# DEALS_STORE=file
# DEALS_DATA_DIR=.data/deals
