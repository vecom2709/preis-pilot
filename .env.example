# Öffentliche Adresse (für kanonische URLs, hreflang und Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Open Food Facts verlangt einen eindeutigen User-Agent: App/Version (Kontakt)
PREISPILOT_USER_AGENT=Preis-Pilot/0.1 (info@vecom-design.it)
# Erst ab Phase 5/6 nötig (Konten, Haushalte, Community)
DATABASE_URL=postgres://preispilot:preispilot@localhost:5432/preispilot
# Keine Telemetrie an Vercel senden (DSGVO)
NEXT_TELEMETRY_DISABLED=1

# Preis-Pilot 2.0 – kostenlose Schlüssel, optional (ohne Schlüssel zeigt die App einen klaren Hinweis)
# Spielepreise: https://isthereanydeal.com/apps/my/
ITAD_API_KEY=
# Filme/Serien + Streaming-Verfügbarkeit (Lesezugriffs-Token v4): https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
